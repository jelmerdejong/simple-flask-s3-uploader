{
  "name": "simple-flask-s3-uploader",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "updateContentCommand": "python -m pip install --upgrade pip uv",
  "postCreateCommand": "uv sync --locked --group dev",
  "containerEnv": {
    "FLASK_APP": "s3_uploader:create_app"
  },
  "forwardPorts": [
    5000
  ],
  "portsAttributes": {
    "5000": {
      "label": "Flask app",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
